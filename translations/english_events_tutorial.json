    {"line":158,"event":"tutorial_resources3","english_sha256":"642eb2f00ce188012e9f81ee74542f88b26971f836618d2e74fe427fdb333e17","ko":"\"코맥 S. 톰프슨과 헌터 매카시였습니다, 여러분!\""},
