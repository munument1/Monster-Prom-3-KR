{
  "source_sha256": "880f20f61fa08d2953dac6e700e1ec64e229ef0786f7b914bfe2fb58459dc7b6",
  "entries": [
    {
      "line": 3,
      "event": "standard_gas_hitech",
      "english_sha256": "0727c5a1f1b399805f913ef753e37ce52fb7f701774ca65a01c1cbd9316c1199",
      "ko": "주유소일 거라고 철석같이 믿고 차를 몰고 들어왔지만, 솔직히 여기가 우주 정거장이라고 해도 놀랍지 않을 정도야."
    },
    {
      "line": 5,
      "event": "standard_gas_hitech",
      "english_sha256": "ad148df624c09fe842e7fa2248871f4bb1ab7a60805099d51c82f2c66e4a2481",
      "ko": "진심으로, 여기 기술 수준이 존나 미래적이야. 평범한 자동차도 정비해 주긴 하는 걸까?"
    },
    {
      "line": 6,
      "event": "standard_gas_hitech",
      "english_sha256": "6b85f8a14ff9140666a9be901599514c1346f2208201eee278ebe5341237fe5a",
      "ko": "뭐, 알아보는 방법은 하나뿐이지. 뭘 할래?"
    },
    {
      "line": 11,
      "event": "standard_diner_doom",
      "english_sha256": "352e5b65d3bd898c2a444d39117df398db2240b76d52ca4a3f42aeaca016a0df",
      "ko": "넌 전에 '절대로, 무슨 일이 있어도 가면 안 되는 저주받은 식당 TOP 10'이라는 인터넷 목록에서 이 식당을 본 적이 있어."
    },
    {
      "line": 13,
      "event": "standard_diner_doom",
      "english_sha256": "912d82cb3d41e8862a5fd91ba73af2f901c63849c9d8c87ad8b3d49b08fbe3f0",
      "ko": "당연히 넌 그걸 도전장으로 받아들였지."
    },
    {
      "line": 14,
      "event": "standard_diner_doom",
      "english_sha256": "42821b90a1e7286a526381d9cf0963883039804a01f8012cd2ebf7886286d651",
      "ko": "아니, 그동안 온갖 흑마술에 손대 놓고서 식당 하나쯤은 감당할 수 있을 거라 생각한 거야."
    },
    {
      "line": 15,
      "event": "standard_diner_doom",
      "english_sha256": "237a53f99f6cfd87a6fa5d72497a399c0d14bea0cbc5542ce6cca9fa9b06ed58",
      "ko": "그래서 여기까지 왔는데, 이제 뭘 할래?"
    },
    {
      "line": 20,
      "event": "standard_motel_regular",
      "english_sha256": "a06540bd22df5d37c142f4240e0846af3daf91cbf6e1c8ad4f78118431ecf1ae",
      "ko": "하루 종일 차에 앉아 있느라 지치고 지친 넌 이제 슬슬 잠자리에 들 준비가 됐어."
    },
    {
      "line": 22,
      "event": "standard_motel_regular",
      "english_sha256": "6eaca88a663889f12f0b0c7ee2b46b036056c3a15c57249cc01366be9b87ca06",
      "ko": "잠들기 전에 무슨 평범한 일을 할지 골라 볼 시간이야. 물론 폴리와 스콧이라면 어떻게든 그걸 괴상하게 만들어 버리겠지만..."
    },
    {
      "line": 27,
      "event": "standard_picnic_spot",
      "english_sha256": "297473155d3ca8d76436e5d04ff17ea1dbbd6f1ea0c344f576ab2aa20618f987",
      "ko": "햇살은 눈부시고, 새들은 지저귀고, 개미들은 네가 흘릴 음식 부스러기를 먹을 생각에 잔뜩 들떠 있어."
    },
    {
      "line": 29,
      "event": "standard_picnic_spot",
      "english_sha256": "01f3f59e5ef94815c2cd01abbd344b0023438b238581d256f2409f68d3a3e701",
      "ko": "소풍 가기 딱 좋은 날이네!"
    },
    {
      "line": 30,
      "event": "standard_picnic_spot",
      "english_sha256": "092e8bffe30f968088fadb55f1d87816994c9579d431173d24fb540cb5a42d55",
      "ko": "피크닉 바구니도 챙겼고 체크무늬 돗자리도 폈어. 이제 여기서 뭘 할지만 결정하면 돼."
    },
    {
      "line": 35,
      "event": "standard_biker_bar",
      "english_sha256": "311b8f72085b744c03cbff8540e4512d0136ba13fdfffe5ee2c96336c56ff9cb",
      "ko": "병 깨지는 소리, 부딪히는 술잔, 굉음을 내는 오토바이, 방금 어떤 놈이 날아가 처박힌 창문이 산산조각 나는 소리..."
    },
    {
      "line": 37,
      "event": "standard_biker_bar",
      "english_sha256": "57ae8144df852a1ea671a0fa36fab03baeedba444df6f42d1f7f63e234e64a57",
      "ko": "이것이야말로 진정한 바이커 바에서 울려 퍼지는 감미로운 선율이지."
    },
    {
      "line": 38,
      "event": "standard_biker_bar",
      "english_sha256": "70c6a608f6093dc23bf6b3df9651bfb068d4c2713e9c3387fbb0254ab2e96df9",
      "ko": "네 안에 잠든 상남자를 깨울 기회야. 뭘 할래?"
    },
    {
      "line": 43,
      "event": "standard_graveyard",
      "english_sha256": "99305018a7877222809a9c14ceedeb4a50e7f6a389310ba06b3ab043250eda52",
      "ko": "묘지는 엄숙하고 고요하게 죽은 이를 추모하며 삶을 되돌아보는 곳이야..."
    },
    {
      "line": 45,
      "event": "standard_graveyard",
      "english_sha256": "c598a409ec917ce4c6e1064479bcb59ea90cf56f008e30d0310dabab5c60de22",
      "ko": "...뭐, 따분한 인간들이나 그렇지. 넌 폴리와 스콧이랑 왔잖아. 그러니까 묘지야말로 장난치기 딱 좋은 곳이지!"
    },
    {
      "line": 46,
      "event": "standard_graveyard",
      "english_sha256": "69d28b402a552b5fc130b95f9f46d01ca1d5c8f08de8b2150264309c9984a360",
      "ko": "문제는 어떤 장난을 쳐야 가장 끝내주냐는 거야."
    },
    {
      "line": 51,
      "event": "standard_village_west",
      "english_sha256": "66705a3ad402682db41e933fc2adcfd26ae81c60c6c85124ce700dcb48e15916",
      "ko": "육연발 권총과 무법자, 야생마와 챙이 넓은 카우보이모자가 넘쳐나는 땅에 온 걸 환영해."
    },
    {
      "line": 53,
      "event": "standard_village_west",
      "english_sha256": "815e78566f36ca8933786f7dc1116769514bd1664590bcaa2002c94718272277",
      "ko": "넌 언제나 진짜 카우보이가 되고 싶었어. 아니, 최소한 TV에 나오는 그런 카우보이라도 말이야. 드디어 기회가 왔네!"
    },
    {
      "line": 54,
      "event": "standard_village_west",
      "english_sha256": "f9a0317cea7bbb3435a06467fd8bc0433e4a6aa2560282e737f40a210554ab57",
      "ko": "자, 뭘 해 볼 텐가... 친구 양반?"
    },
    {
      "line": 59,
      "event": "standard_art_exhibition",
      "english_sha256": "0ad520ed7e3b045fbaf91f393271cf1d0bdeec095a4cb4b462c91223e617269e",
      "ko": "예술은 아름다워. 예술은 감정을 움직이지. 예술은 괴물로 산다는 게 어떤 건지 거침없이 파헤치는 탐구야."
    },
    {
      "line": 61,
      "event": "standard_art_exhibition",
      "english_sha256": "2197fb28a0f02f0ea03d9bcba99b6e89b9754fb117b183c8254d2f029d998523",
      "ko": "그리고 예술이란, 알고 보니 파란 캔버스에 흰 줄 하나 그어 놓고 40밀리언 달러를 받아 처먹는 거였어."
    },
    {
      "line": 62,
      "event": "standard_art_exhibition",
      "english_sha256": "65992251997e7626e39994bbc2d3ca2c64dcd307d29c5794f0e4c09738e23296",
      "ko": "교양 좀 쌓아 볼 시간이야. 미술 전시회에서 뭘 할래?"
    },
    {
      "line": 67,
      "event": "standard_lake",
      "english_sha256": "4066c9e505284aabb4273f4bd994b3ac883df0250108caf531b913d81f7e8b34",
      "ko": "이렇게 덥고 화창한 날에는 호수에 놀러 가는 것만큼 더위를 식히기 좋은 방법도 없지."
    },
    {
      "line": 69,
      "event": "standard_lake",
      "english_sha256": "de78de1bd82aa6199ff6540de7956638fd6dfcad671906d47acf4eb28a9bf377",
      "ko": "게다가 섹시한 친구들이 수영복 입은 모습도 실컷 구경할 수 있잖아!"
    },
    {
      "line": 70,
      "event": "standard_lake",
      "english_sha256": "7b5e430dd4fc076d8da1d2d434bbf1a09d4dd447b2946277b797498325862b01",
      "ko": "물론 넌 지금까지 줄곧 그 광경을 상상하고 있던 건 아니야... 응, 절대 아니고말고. *콜록 콜록*."
    },
    {
      "line": 71,
      "event": "standard_lake",
      "english_sha256": "969b9c42dce0a31b95492f5ab525b999095d710b56e2f61df23f6accc588bf64",
      "ko": "아무튼 여기까지 왔으니 뭘 할래?"
    },
    {
      "line": 76,
      "event": "standard_diner_pancake",
      "english_sha256": "14037b565928104bb46ee0da16d4bd5304d5e90927810b6adb025bba3d6a9359",
      "ko": "아침은 하루 중 가장 중요한 식사야. 그중에서도 최고는 시럽을 듬뿍 끼얹은 폭신폭신한 탄수화물 탑이지."
    },
    {
      "line": 78,
      "event": "standard_diner_pancake",
      "english_sha256": "de0e772a94dfd994bd40ad872838777ab4e11777197fa0647286da5a4fed0f74",
      "ko": "이 식당 메뉴에는 말도 안 되게 거대한 음식들이 있어. 배가 아주 고팠으면 좋겠네!"
    },
    {
      "line": 79,
      "event": "standard_diner_pancake",
      "english_sha256": "507adf1b2f95b20099f0b98c58a4a038c71e37f671df77da548eeb6dee1c13e9",
      "ko": "먹을 팬케이크는 이렇게 많은데 시간은 너무 부족해! 어떤 걸 주문할래?"
    },
    {
      "line": 84,
      "event": "standard_diner_dinest",
      "english_sha256": "26e1808d6526830aa911bd40ad09733ba341f499dc213600573807ac72d08c33",
      "ko": "다이네스트는 입맛 까다로운 여행객들을 위한 고급 식당이야."
    },
    {
      "line": 86,
      "event": "standard_diner_dinest",
      "english_sha256": "92307482def9b7234e1f73db838cd7d7606a0b2ba3bbd8ff69b83bcb7cd525cc",
      "ko": "안타깝게도 세상 사람들 전부가 입맛 까다로운 여행객인 모양이야. 여기 진짜 발 디딜 틈이 없어."
    },
    {
      "line": 87,
      "event": "standard_diner_dinest",
      "english_sha256": "000b220c0d5aa1dc8fa7062023b3d8c6d17fc10ad955e22cd176687e2d702fc2",
      "ko": "당장 자리를 잡으려면 모르는 사람과 합석하는 수밖에 없어."
    },
    {
      "line": 88,
      "event": "standard_diner_dinest",
      "english_sha256": "46c820c396a14cdd25bf0e0de063dd243a226f3c02b94b274cd621a5460d3bf4",
      "ko": "예의범절 따위 박살 내고 새 친구를 사귈 절호의 기회네! 누구 옆에 앉을래?"
    },
    {
      "line": 93,
      "event": "standard_gas_trolls",
      "english_sha256": "b20adfaa37efe5775dd89e6d173a42dbf0a7f62a2ba145fb249e23743fdd3b08",
      "ko": "이 주유소는 마치 어린이 동화책에서 통째로 튀어나온 것 같아."
    },
    {
      "line": 94,
      "event": "standard_gas_trolls",
      "english_sha256": "afeba5d2f33feabdda29d50dcedae840bb803bde807b61471586f85de66798e6",
      "ko": "뭐, 판타지 영웅들이 자동차를 몰고 다니는 동화책이겠지만. 아무튼 그렇다고!"
    },
    {
      "line": 96,
      "event": "standard_gas_trolls",
      "english_sha256": "4cedd05b65f8c10e77041c0e1fe3a4752596aa794f5789da62e14da49e27bf1b",
      "ko": "기이하고 동화 같은 장식 투성이지만 주유소로서 갖출 건 다 갖춘 것 같아. 뭘 할래?"
    },
    {
      "line": 101,
      "event": "standard_gas_basic",
      "english_sha256": "8c6caa1b592e0cc137a4dfb0f665eaadaa071ec3becd7627021bc5ab1f56c3b3",
      "ko": "주유소는 뭐든 바가지요금에 오염물질투성이야. 더러운 화장실에선 날마다 신종 질병이 탄생하는 것 같고."
    },
    {
      "line": 103,
      "event": "standard_gas_basic",
      "english_sha256": "58eca5abd0a2d45d9308e2388c67181cde3871cfa1203f01bdc29fa3aa0ffca0",
      "ko": "그래도 차를 굴리려면 감수해야 하는 필요악이지. 로드트립의 세계에 온 걸 환영해!"
    },
    {
      "line": 104,
      "event": "standard_gas_basic",
      "english_sha256": "93a4be8485c7f1e0e1be9641326455f1a14e79430b6a2eb877801dbf0abf8c6b",
      "ko": "그래서, 뭘 할래?"
    },
    {
      "line": 109,
      "event": "standard_motel_cheap",
      "english_sha256": "3cef78a621aca80da9fddd99a49cfaf1f5ab69b518b8f005c8a51989d4be1d6e",
      "ko": "돈을 아끼는 게 부끄러운 일은 아니지만, 솔직히 그냥 차에서 자는 편이 나았을지도 몰라."
    },
    {
      "line": 111,
      "event": "standard_motel_cheap",
      "english_sha256": "2991cd7aa8d5fba96c8894caff5c1576d0a4063c0b7738b5f6bbb5c628f71a65",
      "ko": "뭐, 살다 보면 하룻밤쯤은 고생도 해 봐야지. 그래야 인격이 단련된다잖아!"
    },
    {
      "line": 112,
      "event": "standard_motel_cheap",
      "english_sha256": "fcf13e570d0e3b6b234843a2159fe0ac049c30c042a95bfb9c733d0cb8f4a613",
      "ko": "적어도 눈 뜨고 보기 힘든 객실 목록을 훑는 동안엔 그렇게 스스로를 위로해 봐..."
    },
    {
      "line": 113,
      "event": "standard_motel_cheap",
      "english_sha256": "91a999ae34b83c7e6f6fd2d8013d8e192bd4e4914fa7dbf196ed80aa7bf975e7",
      "ko": "이제 와서 발 빼기는 늦었어. 오늘 밤엔 어떤 방을 빌릴래?"
    },
    {
      "line": 118,
      "event": "standard_motel_fancy",
      "english_sha256": "8a0a0431c43128acfc552e201bbba4d647e3fa682ab8ab624df78c0b3872ff8c",
      "ko": "제대로 된 호텔에 묵자니 돈이 아깝고, 평범한 모텔에 묵자니 눈이 너무 높다면 어디로 가야 할까? 아무래도 여기인 모양이네!"
    },
    {
      "line": 120,
      "event": "standard_motel_fancy",
      "english_sha256": "c486a0c12568e293015cda0303d39a517807582b2602ef1a68ec922d4fcb2088",
      "ko": "이곳엔 품격과 매력, 우아함이 넘쳐흘러. 공교롭게도 네겐 평생 없었던 것들이지."
    },
    {
      "line": 121,
      "event": "standard_motel_fancy",
      "english_sha256": "921048ef8d7e17d3ce62cfdc8e31de17680002364568daafb6bb87207723c13f",
      "ko": "그러니 오늘 밤은 돈 많고 고상한 부자 코스프레를 하기 딱 좋은 밤이야! 뭘 할래?"
    },
    {
      "line": 126,
      "event": "standard_lab",
      "english_sha256": "260e3a93ca29f3851ad803d96f008e3273df0518c43d91c805b0a2df312d4fd5",
      "ko": "정부 음모론을 믿는 편이야? 뭐, 이제 곧 믿게 될 거야."
    },
    {
      "line": 128,
      "event": "standard_lab",
      "english_sha256": "fd0eae148cc4b40538d7bae2b924c1dd2cd6611f2f643d002778e10685debd64",
      "ko": "비밀 정부 연구소에 온 걸 환영해. 네가 제일 좋아하는 정치인들이 과학자들에게 신 노릇 좀 해 보라고 시키는 곳이지."
    },
    {
      "line": 129,
      "event": "standard_lab",
      "english_sha256": "01667c8a62f070252827ec00c9ece3f83b336b30755cf7e9f80df62d07c9338b",
      "ko": "섬뜩한 실험과 돌연변이 생물, 괴물의 존엄을 짓밟는 범죄가 여기저기 널려 있어."
    },
    {
      "line": 130,
      "event": "standard_lab",
      "english_sha256": "e4feaac86a8a57555363e8a2bfca1c3598852d0c757ba719e4c247b19b8fe8a3",
      "ko": "뭐가 제일 흥미로워 보여?"
    },
    {
      "line": 135,
      "event": "standard_shady_property",
      "english_sha256": "107941f035969a44433533850a67c7a783c75dbf154026135efd1e68ca7b7ad2",
